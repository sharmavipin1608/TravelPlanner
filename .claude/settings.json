{
  "hooks": {
    "PreToolUse": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "bash hooks/pre_task.sh" }] },
      { "matcher": "", "hooks": [{ "type": "command", "command": "bash hooks/classify_task.sh" }] },
      { "matcher": "", "hooks": [{ "type": "command", "command": "bash hooks/budget_guard.sh" }] },
      { "matcher": "", "hooks": [{ "type": "command", "command": "bash hooks/log_tool.sh" }] }
    ],
    "PostToolUse": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "bash hooks/post_task.sh" }] },
      { "matcher": "", "hooks": [{ "type": "command", "command": "bash hooks/log_tool.sh" }] }
    ],
    "Stop": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "bash hooks/on_error.sh" }] }
    ]
  },
  "agents": {
    "default_model": "sonnet"
  }
}
